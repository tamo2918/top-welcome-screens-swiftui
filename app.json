{
  "expo": {
    "name": "Welcome Screen Gallery",
    "slug": "welcome-screen-gallery",
    "description": "Open-source Expo gallery with 10 animated splash, loading, welcome, and onboarding screen studies.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/welcome-gallery-icon.png",
    "scheme": "welcome-showcase",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/welcome-gallery-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "dev.appllama.welcomescreens",
      "appleTeamId": "M89F5A3ZGY"
    },
    "android": {
      "package": "dev.appllama.welcomescreens",
      "adaptiveIcon": {
        "backgroundColor": "#080B20",
        "foregroundImage": "./assets/images/welcome-gallery-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/welcome-gallery-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
