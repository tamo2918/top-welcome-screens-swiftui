{
  "name": "welcome-screen-gallery",
  "main": "expo-router/entry",
  "react-native": "./src/index.ts",
  "types": "./src/index.ts",
  "version": "1.0.0",
  "description": "Open-source React Native Expo UI kit with 10 animated splash, loading, welcome, and onboarding screen studies.",
  "keywords": [
    "expo",
    "react-native",
    "expo-router",
    "typescript",
    "reanimated",
    "onboarding",
    "onboarding-screen",
    "splash-screen",
    "animated-splash-screen",
    "welcome-screen",
    "loading-screen",
    "react-native-ui",
    "react-native-template",
    "expo-template",
    "mobile-ui",
    "ios",
    "android",
    "ui-inspiration",
    "open-source",
    "app-design"
  ],
  "license": "GPL-3.0-only",
  "author": {
    "name": "Appllama",
    "url": "https://appllama.io"
  },
  "contributors": [
    {
      "name": "Jaimin",
      "url": "https://x.com/jaimintf"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Appllama/top-welcome-screens.git"
  },
  "homepage": "https://github.com/Appllama/top-welcome-screens#readme",
  "bugs": {
    "url": "https://github.com/Appllama/top-welcome-screens/issues"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/welcome",
    "assets/images/welcome-gallery-icon.png",
    "assets/images/welcome-gallery-favicon.png",
    "docs",
    "src/index.ts",
    "src/store",
    "src/welcome-screens",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "~57.0.11",
    "expo-asset": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run export:web"
  }
}
