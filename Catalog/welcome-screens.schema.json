{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tamo2918/top-welcome-screens-swiftui/blob/main/Catalog/welcome-screens.schema.json",
  "title": "Welcome Screens Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "catalogVersion", "project", "sharedFiles", "screens"],
  "properties": {
    "$schema": { "type": "string" },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "project": { "$ref": "#/$defs/project" },
    "sharedFiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/sharedFile" }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/screen" }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "platform",
        "uiFramework",
        "minimumDeploymentTarget",
        "referenceCanvas",
        "screenCount",
        "semanticActionCount",
        "motionSpecPath",
        "integrationGuidePath",
        "legalNoticePath",
        "assetProvenancePath"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "platform": { "const": "iOS" },
        "uiFramework": { "const": "SwiftUI" },
        "minimumDeploymentTarget": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "referenceCanvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "screenCount": { "type": "integer", "minimum": 1 },
        "semanticActionCount": { "type": "integer", "minimum": 1 },
        "motionSpecPath": { "$ref": "#/$defs/repositoryPath" },
        "integrationGuidePath": { "$ref": "#/$defs/repositoryPath" },
        "legalNoticePath": { "$ref": "#/$defs/repositoryPath" },
        "assetProvenancePath": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "sharedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "requiredWhen"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "role": { "type": "string", "minLength": 1 },
        "requiredWhen": {
          "enum": ["always", "animated", "recommended", "gallery-only"]
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "swiftUIView",
        "sourcePath",
        "categories",
        "animated",
        "durationMilliseconds",
        "assets",
        "fontFiles",
        "actions",
        "motion",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "swiftUIView": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "sourcePath": { "$ref": "#/$defs/repositoryPath" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["splash", "loading", "welcome", "onboarding", "authentication"] }
        },
        "animated": { "type": "boolean" },
        "durationMilliseconds": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "fontFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "motion": {
          "type": "array",
          "items": { "$ref": "#/$defs/motionEvent" }
        },
        "notes": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "availableFromMilliseconds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "availableFromMilliseconds": { "type": "integer", "minimum": 0 },
        "availableUntilMilliseconds": { "type": "integer", "minimum": 1 }
      }
    },
    "motionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMilliseconds", "effect", "description"],
      "properties": {
        "startMilliseconds": { "type": "integer", "minimum": 0 },
        "endMilliseconds": { "type": "integer", "minimum": 1 },
        "effect": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
