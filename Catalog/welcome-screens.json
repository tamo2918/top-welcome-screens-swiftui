{
  "$schema": "./welcome-screens.schema.json",
  "catalogVersion": 1,
  "project": {
    "name": "Top Welcome Screens for SwiftUI",
    "platform": "iOS",
    "uiFramework": "SwiftUI",
    "minimumDeploymentTarget": "16.4",
    "referenceCanvas": {
      "width": 640,
      "height": 1385
    },
    "screenCount": 10,
    "semanticActionCount": 33,
    "motionSpecPath": "docs/MOTION_SPEC.md",
    "integrationGuidePath": "docs/SWIFTUI_IMPLEMENTATION_GUIDE.md",
    "legalNoticePath": "NOTICE.md",
    "assetProvenancePath": "docs/ASSET_PROVENANCE.md"
  },
  "sharedFiles": [
    {
      "path": "WelcomeScreenGallery/Shared/ReferenceGeometry.swift",
      "role": "Defines the 640×1385 reference coordinate system and absolute placement helpers.",
      "requiredWhen": "always"
    },
    {
      "path": "WelcomeScreenGallery/Shared/ReferenceCanvas.swift",
      "role": "Uniformly scales, centers, and clips the reference canvas for the host display.",
      "requiredWhen": "always"
    },
    {
      "path": "WelcomeScreenGallery/Shared/ReplicaAssets.swift",
      "role": "Resolves bundled replica images and fixed Inter or Nunito font aliases.",
      "requiredWhen": "always"
    },
    {
      "path": "WelcomeScreenGallery/Shared/ReplicaControls.swift",
      "role": "Provides interaction-gated controls, icons, shared shapes, and color helpers.",
      "requiredWhen": "always"
    },
    {
      "path": "WelcomeScreenGallery/Shared/MotionTimeline.swift",
      "role": "Supplies deterministic elapsed milliseconds, easing helpers, replay, and Reduce Motion behavior.",
      "requiredWhen": "animated"
    },
    {
      "path": "WelcomeScreenGallery/Domain/WelcomeAction.swift",
      "role": "Defines typed semantic actions and host callback resolution.",
      "requiredWhen": "recommended"
    },
    {
      "path": "WelcomeScreenGallery/Domain/WelcomeScreenID.swift",
      "role": "Registers gallery IDs, display names, and motion durations.",
      "requiredWhen": "gallery-only"
    },
    {
      "path": "WelcomeScreenGallery/Features/WelcomeScreen.swift",
      "role": "Switches between all registered gallery studies.",
      "requiredWhen": "gallery-only"
    }
  ],
  "screens": [
